
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>ReShare - Home</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-dark bg-success">
    <div class="container">
        <a class="navbar-brand" href="/">ReShare</a>

        <div>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-light">Login</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-warning">Register</a>
        </div>
    </div>
</nav>

<div class="container text-center mt-5">

    <h1 class="text-success">Welcome to ReShare</h1>

    <h4>Share More, Waste Less!</h4>

    <p class="mt-3">
        ReShare connects people who want to donate unused items
        with people who need them.
    </p>

    <a asp-controller="Donor" asp-action="Index" class="btn btn-success mt-3">
        Donor Dashboard
    </a>

    <a asp-controller="Recipient" asp-action="Index" class="btn btn-outline-success mt-3">
        Browse Donations
    </a>

    <a asp-controller="Admin" asp-action="Index" class="btn btn-dark mt-3">
        Admin Dashboard
    </a>

</div>

</body>
</html>
